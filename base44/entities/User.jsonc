{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "description": "System role (admin or user)"
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "main_office",
          "dd_team_manager",
          "dd_team_employee"
        ]
      },
      "default": [],
      "description": "Follow Up roles assigned to the user (can be multiple)"
    },
    "dd_employee_id": {
      "type": "string",
      "description": "Only for dd_team_employee - matching edikted_employees.id from the Edikted DB"
    }
  }
}